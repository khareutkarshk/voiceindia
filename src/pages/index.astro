      <section id="outcomes" class="ch relative bg-navy pt-[clamp(72px,11vh,140px)] pb-[clamp(80px,12vh,160px)] text-on-navy" data-tone="dark" aria-labelledby="h-outcomes">
        <div class="wrap relative z-3 grid grid-cols-[minmax(0,5fr)_minmax(0,7fr)] items-start gap-x-[clamp(32px,5vw,96px)] gap-y-10 max-lg:grid-cols-1">
          <div class="sticky top-[calc(var(--nav)_+_12vh)] grid gap-5.5 max-lg:static">
            <h2 id="h-outcomes" class="reveal text-white">Judged by what changes</h2>
            <p class="fade max-w-[40ch]">A pilot measures six things, against a baseline you agree before it starts. Actual impact depends on your portfolio, data quality, workflow design, policy and that baseline.</p>
          </div>
          <ol class="measures grid">
            {outcomes.map((o, i) => (
              <li class="group/m grid gap-3.5 py-[clamp(18px,4vh,40px)]" data-i={i} data-active={i === 0 ? 'true' : 'false'}>
                <h3 class="text-[length:clamp(2.75rem,1rem_+_5vw,6.5rem)] leading-[.95] tracking-[-.05em] text-on-navy/22 transition-colors duration-[450ms] ease-out group-data-[active=true]/m:text-white motion-reduce:transition-none">{o.name}</h3>
                <div class="grid gap-2.5 opacity-38 transition-opacity duration-[450ms] ease-out group-data-[active=true]/m:opacity-100 motion-reduce:transition-none">
                  <ul class="flex flex-wrap gap-2">{o.counts.map((c) => <li class="rounded-full bg-on-navy/10 px-3 py-1.5 text-small font-semibold text-white group-data-[active=true]/m:first:bg-orange group-data-[active=true]/m:first:text-navy">{c}</li>)}</ul>
                  <p class="max-w-[34ch] text-lead leading-[1.4] text-white">{o.her}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section id="pilot" class="ch relative bg-[linear-gradient(180deg,var(--color-mist)_0%,#EAF1FF_100%)] pt-[clamp(56px,8vh,104px)]" data-state="cta" data-tone="light" aria-labelledby="h-cta">
        <div class="wrap relative z-3 grid grid-cols-[minmax(0,6fr)_minmax(0,5fr)] items-center gap-x-[clamp(32px,5vw,96px)] gap-y-10 max-lg:grid-cols-1">
          <div class="grid gap-6">
            <h2 id="h-cta" class="reveal">Prove it on one workflow first</h2>
            <p class="fade max-w-[44ch] text-lead leading-[1.45]">Pick one collection segment or queue. Agree the baseline, the data it may use and who approves what. Run a controlled pilot, review the results, then decide what to scale.</p>
            <ol class="fade grid gap-2.5">
              {[['Define', 'the use case, the baseline and what success means'], ['Connect', 'data access, permissions and integration scope'], ['Validate', 'recommendations, exceptions, security and outcomes'], ['Scale', 'only after operational and governance sign-off']].map(([b, t]) => <li class="relative pl-5.5 text-slate before:absolute before:top-[.62em] before:left-0 before:size-2 before:rounded-full before:bg-orange before:content-['']"><b class="text-navy">{b}</b> {t}</li>)}
            </ol>
          </div>
          <form class="grid gap-3.5 rounded-[10px] border border-line bg-white p-[clamp(18px,1.6vw,26px)] shadow-[0_24px_60px_-32px_rgba(7,27,73,.35)]" id="demo" data-ui action={`mailto:${mail}`} method="get" novalidate>
            <p class={cardTitle}>Request a Collections SI demonstration</p>
            <div class="grid grid-cols-2 gap-3.5 max-lg:grid-cols-1">
              <label class="grid gap-1.5 text-small font-semibold text-navy">Name<input class="field" name="name" autocomplete="name" required /></label>
              <label class="grid gap-1.5 text-small font-semibold text-navy">Work email<input class="field" name="email" type="email" autocomplete="email" required /></label>
            </div>
            <div class="grid grid-cols-2 gap-3.5 max-lg:grid-cols-1">
              <label class="grid gap-1.5 text-small font-semibold text-navy">Organisation<input class="field" name="org" autocomplete="organization" required /></label>
              <label class="grid gap-1.5 text-small font-semibold text-navy">Role<input class="field" name="role" autocomplete="organization-title" /></label>
            </div>
            <div class="grid grid-cols-2 gap-3.5 max-lg:grid-cols-1">
              <label class="grid gap-1.5 text-small font-semibold text-navy">Use case
                <select class="field" name="usecase"><option>Collections</option><option>Customer service</option><option>Portfolio intelligence</option><option>Risk and compliance</option><option>Other</option></select>
              </label>
              <label class="grid gap-1.5 text-small font-semibold text-navy">Deployment
                <select class="field" name="deploy"><option>Not sure yet</option><option>On premise</option><option>Private cloud</option><option>Hybrid</option></select>
              </label>
            </div>
            <label class="grid gap-1.5 text-small font-semibold text-navy">What would you like to prove?<textarea class="field resize-y" name="brief" rows="3"></textarea></label>
            <div class="flex flex-wrap items-center gap-x-6 gap-y-3.5">
              <button class="btn" type="submit">Prepare the request</button>
              <a class="link" href={`https://mail.google.com/mail/?view=cm&to=${mail}`} target="_blank" rel="noopener">Write in Gmail instead</a>
            </div>
            <p class="text-small text-slate" id="form-note">Opens a written email to {mail}. Please leave out confidential customer information.</p>
          </form>
        </div>
        <div class="pointer-events-none relative z-1 mt-[clamp(24px,5vh,56px)] h-[clamp(200px,30svh,340px)] max-sm:h-[26svh]" data-stage aria-hidden="true"></div>
        <svg class={crestNavy} viewBox="0 0 1440 300" preserveAspectRatio="none" aria-hidden="true"><path d="M0 170C320 120 600 70 900 120S1280 210 1440 160V300H0Z" /></svg>
      </section>
    </main>

    <footer class="foot relative flow-root bg-navy pb-10 text-on-navy">
      <div class="wrap relative z-3 grid justify-items-start gap-5.5 pt-[clamp(72px,12vh,140px)]">
        <p class="fade max-w-[28ch] text-[length:clamp(1.5rem,.9rem_+_1.6vw,2.5rem)] leading-[1.15] font-semibold tracking-[-.03em] text-white">Account 1048 got one call, in Tamil, after payday. Which account is next?</p>
        <a class="btn fade" href="#pilot">Book a demonstration</a>
        <p class="fade text-body font-semibold text-dim">Intelligent. Compliant. Sovereign. Scalable.</p>
      </div>
      <div class="pointer-events-none relative z-1 mx-auto mt-[clamp(24px,5vh,56px)] mb-[clamp(32px,6vh,72px)] h-[clamp(180px,34svh,360px)] w-[calc(100%_-_2*var(--m))] max-w-[calc(1440px_-_2*var(--m))]" data-stage aria-hidden="true"></div>
      <div class="wrap relative z-3 grid grid-cols-[minmax(0,4fr)_minmax(0,2fr)_minmax(0,2fr)_minmax(0,4fr)] gap-8 text-small max-xl:grid-cols-2">
        <p class="leading-[1.6] max-xl:col-span-full"><b class="text-white">Voice India Super Intelligence</b><br />AI-powered conversations. Stronger outcomes.</p>
        <ul class="grid content-start gap-2.5 leading-normal">
          {navItems.map(([href, label]) => <li><a class={footLink} href={href}>{label}</a></li>)}
        </ul>
        <ul class="grid content-start gap-2.5 leading-normal">
          <li><a class={footLink} href="https://www.voiceindia.ai/augmented-ai">Augmented AI</a></li>
          <li><a class={footLink} href="https://www.voiceindia.ai/resonance">Resonance</a></li>
          <li><a class={footLink} href="https://www.voiceindia.ai/">Voice India AI</a></li>
        </ul>
        <p class="leading-[1.7] max-xl:col-span-full"><a class={footLink} href={`mailto:${mail}`}>{mail}</a><br />Tell us what you would like to build.<br /><button class="mt-1.5 font-semibold text-white underline decoration-white/35" type="button" data-copy={mail}>Copy the address</button></p>
        <p class="col-span-full mt-10">© 2026 Voice India. Account 1048 is a simulated case; no real customer data is shown.</p>
      </div>
    </footer>

    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
