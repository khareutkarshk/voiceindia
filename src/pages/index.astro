---
import { Image } from 'astro:assets';
import { existsSync } from 'node:fs';
import logoLight from '../assets/voiceindia-logo-on-light.png';
import logoDark from '../assets/voiceindia-logo-on-dark.png';
import '../styles/site.css';
import '../styles/sections.css';

const site = 'https://voiceindia.si/';
const title = 'Voice India Super Intelligence for Banking and NBFCs';
const description =
  'Connect customer, loan and conversation context to governed decisions and permitted action. Voice India Super Intelligence for banking and NBFC collections.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${site}#org`, name: 'Voice India', url: 'https://www.voiceindia.ai/', logo: `${site}favicon.png`, email: 'tabassum.farheen@voiceindia.ai' },
    { '@type': 'WebSite', '@id': `${site}#site`, url: site, name: 'Voice India Super Intelligence', inLanguage: 'en-IN', publisher: { '@id': `${site}#org` } },
    {
      '@type': 'SoftwareApplication', name: 'Voice India Super Intelligence', applicationCategory: 'BusinessApplication',
      operatingSystem: 'On premise, private cloud or hybrid deployment', description, url: site, publisher: { '@id': `${site}#org` },
      audience: { '@type': 'BusinessAudience', name: 'Banks and NBFCs' },
      featureList: ['Collections Intelligence', 'Customer Intelligence', 'Conversation Intelligence', 'Portfolio Intelligence', 'Risk and Compliance Intelligence', 'Operations Intelligence'],
    },
  ],
};

// The five places her story sits, and what each one knows about her.
const sources = [
  ['Customer', 'Prefers Tamil'],
  ['Loan system', '₹48,500 outstanding, 23 days past due'],
  ['Conversations', '4 calls: “after my salary comes”'],
  ['Transactions', 'Last instalment missed, no active promise'],
  ['Policy', 'Contact hours, consent, approved options'],
];

// The decision loop. The ring of particles holds still; the orange arc and the words move with scroll.
const loop = [
  ['Understand', 'Build a contextual view of the customer, the account, its history and the situation right now.', 'Her account, four calls and her language, read together for the first time.', '4 calls, 1\u00a0language'],
  ['Predict', 'Estimate likely outcomes, identify risks and surface the accounts that deserve attention first.', 'An account that answers calls but never promises is worth a different approach.', '3 explanations'],
  ['Decide', 'Recommend a next best action from evidence, institution policy and the options you have authorised.', 'One call, after her salary credit, inside permitted hours, in Tamil.', 'Call after salary'],
  ['Execute', 'Coordinate voice, messaging, human agents and enterprise workflows within assigned permissions.', 'The call is placed by the SI voice agent, with a person one click away.', 'Day\u00a08, 18:10'],
  ['Learn', 'Compare each recommendation with what actually happened, and improve through evaluated, governed updates.', 'Whether she paid is checked against the payment system, never assumed.', 'Payment checked'],
];

// Account 1048. `word` is what the particles spell beside the step.
const steps = [
  { word: '₹48,500', title: 'Why is this account stuck?', text: 'Four calls, no promise, 23 days past due. Super Intelligence reads the account, the calls and your policy together and proposes three explanations to test. The likeliest: her salary lands after the due date.' },
  { word: 'தமிழ்', title: 'Call after payday, in Tamil', text: 'One recommended action, backed by two facts on record: she asked for a call after payday, and she prefers Tamil. No score is invented to make it look certain.' },
  { word: 'APPROVE', title: 'Nothing reaches her without approval', text: 'The action is checked against contact hours, consent and authority, and higher-impact actions wait for an authorised person. Hold the button on the case to approve this one.' },
  { word: 'வணக்கம்', title: 'The call, in her language', text: 'The SI voice agent calls in Tamil, recognises her concern and records the follow-up she asks for. It makes no promise on her behalf.' },
  { word: 'CALLBACK', title: 'The outcome comes back', text: 'The disposition is logged, the payment is not assumed, and the result is compared with the recommendation. Strategy changes are approved before they reach production.' },
];

// The architecture, top to bottom. The packet falls through these.
const layers = [
  { name: 'Enterprise data and events', text: 'Core banking, LMS, CRM, payment status, telephony, conversations and approved knowledge sources.' },
  { name: 'Context and memory', text: 'Identity resolution where authorised, the account timeline, interaction memory, retrieval and a knowledge graph where implemented.' },
  { name: 'Intelligence', text: 'Rules and policies, predictive models, reasoning, next best action and specialist agents.' },
  { name: 'Orchestration and the policy gate', text: 'Every proposed action is checked against permissions and policy before it reaches a channel or system. High-impact actions and exceptions go to authorised staff. They never bypass the gate.' },
  { name: 'Channels and systems of action', text: 'Voice agents, messaging, human agents, collection workflows, CRM and LMS updates. Payment or system status is verified before an outcome is marked complete.' },
  { name: 'Governance and outcome monitoring', text: 'Access controls, PII controls, audit records, evaluation and monitoring. Each action leaves a copy of itself here.' },
];
const checks = ['Data boundaries', 'Policy-constrained action', 'Human review', 'Audit trail', 'Evaluation'];

const engines = [
  { id: 'collections', name: 'Collections', line: 'Ranks accounts, diagnoses failed attempts and recommends the next permitted recovery action.', inputs: 'Delinquency status, repayment history, contact attempts, previous commitments, approved recovery options.', support: 'Ranks accounts, proposes hypotheses for stalled recovery and compares permitted next actions.', output: 'A recommended next action with its evidence, for an agent or a workflow.' },
  { id: 'customer', name: 'Customer', line: 'One governed view of each customer, account history and interaction memory.', inputs: 'Permitted customer and account records, interaction history, consent and contact preferences.', support: 'Builds a single contextual view that downstream workflows read within their access rights.', output: 'A governed context summary for the workflow in question.' },
  { id: 'conversation', name: 'Conversation', line: 'Context that carries across voice and digital, and knows when a person should take over.', inputs: 'Transcripts and event streams from voice and digital channels, plus account context.', support: 'Identifies objections and intent, carries context between channels and flags when a person should take over.', output: 'Conversation summaries, captured follow-ups and handoff signals.' },
  { id: 'portfolio', name: 'Portfolio', line: 'Where recovery is slowing across buckets, products, channels and teams, and why.', inputs: 'Aggregated portfolio, bucket, product, channel and team data.', support: 'Compares segments and highlights where outcomes move away from the agreed baseline.', output: 'Manager views of patterns and candidate explanations.' },
  { id: 'risk', name: 'Risk and Compliance', line: 'Every workflow held to approved rules, with evidence kept and exceptions routed.', inputs: 'Approved rules and policies, workflow events, action and approval records.', support: 'Checks proposed actions against configured rules and marks exceptions.', output: 'Exception flags, retained evidence and review routing.' },
  { id: 'operations', name: 'Operations', line: 'Where work piles up, explained in plain language.', inputs: 'Queue, handling time, workflow and manual effort data.', support: 'Explains where work accumulates and proposes process changes for evaluation.', output: 'Plain-language explanations and recommended improvements.' },
];

// Real rules, phrased as what the product is built to respect. The institution's compliance team confirms the controls.
const rules = [
  { by: 'RBI', rule: 'Recovery calls only between 8 am and 7 pm, with no harassment, under a board-approved policy.', how: 'Contact windows and recovery options are policy. The gate blocks any action outside them.' },
  { by: 'TRAI', rule: 'Calls and messages follow consent and registered-sender rules under TCCCPR 2018.', how: 'Consent and contact preferences are read before any channel is used.' },
  { by: 'DPDPA', rule: 'The Digital Personal Data Protection Act, 2023: personal data used only for a stated, lawful purpose.', how: 'Each workflow reads only the fields its purpose permits, and every use is recorded.' },
];

// Connectors: start by reading, act only where an action is approved.
const connectors = [
  { name: 'Core banking and lending', reads: 'Her account and repayment schedule', acts: '' },
  { name: 'Loan management and collections', reads: '23 days past due, ₹48,500 outstanding', acts: 'Dispositions and scheduled next actions' },
  { name: 'CRM and case management', reads: 'Prefers Tamil, permitted contact hours', acts: 'Case notes and follow-ups' },
  { name: 'Telephony and communications', reads: 'Her four calls and what she said', acts: 'Approved calls and messages' },
  { name: 'Payments and reconciliation', reads: 'Checks for her salary-day payment', acts: '' },
  { name: 'Enterprise data and knowledge', reads: 'The recovery policy and approved scripts', acts: '' },
];

const outcomes = [
  { name: 'Recovery', counts: ['Collected amount', 'Recovery rate', 'Net recovery cost'], her: 'Did the ₹48,500 move, and what did it cost to move it?' },
  { name: 'Commitment', counts: ['Promise-to-pay rate', 'Kept promises', 'Broken promises'], her: 'One promise she keeps is worth more than three she breaks.' },
  { name: 'Contact', counts: ['Contact rate', 'Right-party contact', 'Attempts per resolution'], her: 'Four calls without a promise. The fifth should be the right one.' },
  { name: 'Experience', counts: ['Dispute resolution time', 'Complaint rate', 'Repeat contact'], her: 'She asked for one thing: a call after payday, in Tamil.' },
  { name: 'Operations', counts: ['Human handling time', 'Manual effort', 'Manager review time'], her: 'Agents spend their time on the moments that need a person.' },
  { name: 'Governance', counts: ['Policy exceptions', 'Action approval rate', 'Audit completeness'], her: 'Every action on her account can be traced and explained.' },
];

const mail = 'tabassum.farheen@voiceindia.ai';
// her recorded line; the Listen control appears only once the file is in public/audio
const hasVoice = existsSync('public/audio/her-line.mp3');
---
<!doctype html>
<html lang="en-IN" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#071B49" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Understand every customer in context. Predict the next best action. Coordinate AI and human teams, with institutional control." />
    <meta property="og:image" content={`${site}og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Voice India Super Intelligence: the intelligence layer for banks and NBFCs." />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content="Customer context, governed decisions and permitted action for banking and NBFC collections." />
    <meta name="twitter:image" content={`${site}og.png`} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/jakarta.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.replace('no-js','js')</script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <canvas id="field" aria-hidden="true"></canvas>

    <header class="nav" id="nav">
      <div class="wrap nav-row">
        <a href="#top" class="brand" aria-label="Voice India Super Intelligence, back to top">
          <Image src={logoLight} alt="Voice India" width={168} height={42} loading="eager" fetchpriority="high" class="logo-l" />
          <Image src={logoDark} alt="" width={168} height={42} loading="eager" class="logo-d" />
        </a>
        <nav aria-label="Sections">
          <ul>
            <li><a href="#account">Account 1048</a></li>
            <li><a href="#gate">The gate</a></li>
            <li><a href="#engines">Engines</a></li>
            <li><a href="#security">Security</a></li>
            <li><a href="#pilot">Pilot</a></li>
          </ul>
        </nav>
        <a class="btn btn-sm" href="#pilot">Book a demo</a>
      </div>
    </header>

    <main id="main">
      <section id="top" class="ch hero" data-state="hero" data-tone="dark" aria-labelledby="h-hero">
        <div class="stage hero-stage" data-stage aria-hidden="true"></div>
        <div class="wrap hero-grid">
          <!-- The kolam: a grid of rice-flour dots with one unbroken line around every one of them, drawn in particles. -->
          <div class="kolam-box" data-kolam aria-hidden="true"></div>
          <!-- Tamil lines here and in the case are drafts: to be verified by a native speaker before launch. -->
          <figure class="voice" id="voice" aria-label="A simulated customer, speaking Tamil">
            <p class="voice-ta" lang="ta">சம்பளம் வந்த பிறகுதான் கட்ட முடியும். அதற்குப் பிறகு கூப்பிடுங்கள்.</p>
            <p class="voice-en">“I can only pay after my salary comes in. Call me after that.”</p>
            <figcaption>Account 1048, 23 days past due. A simulated customer. {hasVoice && <button type="button" class="listen" id="listen" aria-pressed="false">Hear her</button>}</figcaption>
          </figure>
          <div class="hero-foot">
            <h1 id="h-hero" class="reveal">Know the borrower before the next call</h1>
            <div class="hero-side">
              <p class="lead fade">Voice India Super Intelligence is the decision layer for banks and NBFCs. It reads every account in context, recommends the next permitted action and keeps your people in charge of each decision.</p>
              <div class="actions fade">
                <a class="btn" href="#pilot">Book a demonstration</a>
                <a class="link" href="#account">Follow one account</a>
              </div>
              <p class="trust-line fade">Built for RBI, TRAI and DPDPA requirements. Runs on premise, in a private cloud or hybrid.</p>
            </div>
          </div>
        </div>
      </section>

      <section id="problem" class="ch scatter" data-state="scatter" data-tone="dark" aria-labelledby="h-scatter">
        <div class="wrap scatter-grid">
          <div class="scatter-copy">
            <h2 id="h-scatter" class="reveal">Her story sits in five systems</h2>
            <p class="fade">Her repayment history sits in the loan system, her promise in a call recording, her language in the CRM and your policy in a PDF. When the next call is made, nobody sees it together.</p>
            <p class="fade">So the fifth call sounds like the first four.</p>
          </div>
          <div class="stage scatter-stage" data-stage aria-hidden="true">
            {sources.map(([n, d], i) => <span style={`--l:${i}`}><b>{n}</b>{d}</span>)}
          </div>
        </div>
        <svg class="crest crest-light" viewBox="0 0 1440 300" preserveAspectRatio="none" aria-hidden="true"><path d="M0 210C300 150 640 120 940 170S1300 250 1440 200V300H0Z" /></svg>
      </section>

      <section id="loop" class="ch loop" data-tone="light" aria-labelledby="h-loop" style={`--steps:${loop.length}`}>
        <div class="pin">
          <div class="wrap loop-grid">
            <div class="loop-ring">
              <div class="stage ring-stage" data-stage aria-hidden="true"></div>
              <svg class="ring-arc" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="40" pathLength="1" /></svg>
              <div class="ring-word" aria-hidden="true" data-facts={JSON.stringify(loop.map((l) => l[3]))}><span id="ring-step">Account 1048</span><b id="ring-word">{loop[0][3]}</b></div>
              <ol class="ring-names">
                {loop.map(([n], i) => <li style={`--a:${i * 72 - 90}deg`} data-i={i}>{n}</li>)}
              </ol>
            </div>
            <div class="loop-copy">
              <h2 id="h-loop" class="reveal">One continuous decision loop</h2>
              <p class="fade loop-sub">Super Intelligence connects the systems you already run and moves your teams from raw data to decisions, permitted actions and verified outcomes.</p>
              <div class="loop-steps">
                {loop.map(([n, t, h], i) => (
                  <article class="loop-step" data-i={i} data-active={i === 0 ? 'true' : 'false'}>
                    <h3>{n}</h3>
                    <p>{t}</p>
                    <p class="her">{h}</p>
                  </article>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="account" class="ch case" data-state="case" data-tone="light" aria-labelledby="h-case" style={`--steps:${steps.length}`}>
        <div class="pin">
          <div class="wrap case-head">
            <h2 id="h-case">Account 1048 <span>A simulated collections case</span></h2>
            <div class="case-nav">
              <p class="count" aria-live="polite"><span id="step-now">1</span> of {steps.length}</p>
              <button class="arrow" data-dir="-1" aria-label="Previous step"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg></button>
              <button class="arrow" data-dir="1" aria-label="Next step"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg></button>
              <a class="skip-link" href="#gate">Skip</a>
            </div>
          </div>
          <div class="wrap case-body">
            <div class="case-left">
              <div class="steps">
                {steps.map((s, i) => (
                  <article class="step" data-step={i} data-active={i === 0 ? 'true' : 'false'} aria-hidden={i === 0 ? 'false' : 'true'}>
                    <h3>{s.title}</h3>
                    <p>{s.text}</p>
                  </article>
                ))}
              </div>
              <div class="stage case-stage" data-stage data-words={JSON.stringify(steps.map((s) => s.word))} aria-hidden="true"></div>
            </div>
            <div class="case-card" data-ui data-at="0">
              <p class="cc-head"><b>Account 1048</b><span>Simulated. Collections queue, bucket 1–30</span></p>
              <dl class="cc-stats">
                <div><dt>Outstanding</dt><dd>₹48,500</dd></div>
                <div><dt>Days past due</dt><dd>23</dd></div>
                <div><dt>Language</dt><dd>Tamil</dd></div>
                <div class="cc-more"><dt>Contacts</dt><dd>4</dd></div>
                <div class="cc-more"><dt>Promise to pay</dt><dd>None</dd></div>
                <div class="cc-more"><dt>Last outcome</dt><dd>Call after salary</dd></div>
              </dl>
              <ol class="cc-log">
                <li data-i="0">
                  <p class="cc-label">Diagnosis <time>10:31</time></p>
                  <p class="cc-sum">A: salary lands after the due date</p>
                  <div class="cc-body">
                    <p><b>A</b> Salary lands after the due date</p>
                    <p class="cc-alt"><b>B</b> An earlier question was never answered</p>
                    <p class="cc-alt"><b>C</b> Contact details are out of date</p>
                    <p class="cc-note">Hypotheses to test on the next permitted contact. None is a fact yet.</p>
                  </div>
                </li>
                <li data-i="1">
                  <p class="cc-label">Recommendation <time>10:33</time></p>
                  <p class="cc-sum">Call after salary credit, in Tamil</p>
                  <div class="cc-body"><p>Follow-up call after her salary credit, within permitted hours, in Tamil. Priority medium.</p><p class="cc-note">Basis: her own request and recorded preference.</p></div>
                </li>
                <li data-i="2">
                  <p class="cc-label">Approval <time id="approve-time">waiting</time></p>
                  <p class="cc-sum" id="approve-sum">Approved</p>
                  <div class="cc-body">
                    <button class="hold" id="hold" type="button">
                      <span class="hold-label">Hold to approve</span>
                      <span class="hold-fill" aria-hidden="true"><span class="hold-label">Hold to approve</span></span>
                    </button>
                    <p class="gate-status" id="gate-status" aria-live="polite">Contact hours, consent and authority checked</p>
                  </div>
                </li>
                <li data-i="3">
                  <p class="cc-label">Call <time>Day 8, 18:10</time></p>
                  <p class="cc-sum">Follow-up recorded, in Tamil</p>
                  <div class="cc-body chat">
                    <p class="them"><span lang="ta">சம்பளம் வந்த பிறகுதான் கட்ட முடியும்.</span>I can only pay after my salary comes in.</p>
                    <p class="us"><span lang="ta">புரிகிறது. சம்பளம் வந்த பிறகு தமிழில் அழைக்கிறோம்.</span>Understood. We will call after your salary credit, in Tamil.</p>
                    <p class="them"><span lang="ta">முதல் வாரத்துக்குப் பிறகு சரி.</span>After the first week is fine.</p>
                    <p class="cc-note">No payment commitment was made on this call.</p>
                  </div>
                </li>
                <li data-i="4">
                  <p class="cc-label">Outcome <time>Day 9, 17:05</time></p>
                  <p class="cc-sum">Callback requested</p>
                  <div class="cc-body"><p>Callback requested. Payment not confirmed. Compared with the recommendation.</p></div>
                </li>
              </ol>
            </div>
          </div>
        </div>
      </section>

      <section id="gate" class="ch gate" data-tone="dark" aria-labelledby="h-gate">
        <div class="pin">
          <div class="wrap gate-grid">
            <div class="gate-copy">
              <h2 id="h-gate" class="reveal">Every action passes the gate</h2>
              <p class="fade gate-sub">Financial services needs more than a useful answer. Follow the call for Account 1048 down through the six layers of Super Intelligence.</p>
              <div class="layer-text" aria-live="polite">
                {layers.map((l, i) => (
                  <article data-i={i} data-active={i === 0 ? 'true' : 'false'}>
                    <h3><span>Layer {i + 1} of 6</span>{l.name}</h3>
                    <p>{l.text}</p>
                  </article>
                ))}
              </div>
              <ul class="checks" aria-label="Controls passed">
                {checks.map((c, i) => <li data-i={i}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m3.5 8.5 3 3 6-7" /></svg>{c}</li>)}
              </ul>
            </div>
            <div class="stack-wrap" aria-hidden="true">
              <div class="stack">
                {layers.map((l, i) => (
                  <div class={`plate${i === 3 ? ' plate-gate' : ''}`} style={`--i:${i}`} data-i={i}>
                    <span class="plate-name">{l.name.replace(' and the policy gate', '')}</span>
                    {i === 3 && <span class="scan"></span>}
                    {i === 5 && <span class="ghost"></span>}
                  </div>
                ))}
                <div class="packet"><span class="split"></span></div>
                <div class="reviewer"><span>Sent to an authorised reviewer</span><b>Approved</b></div>
              </div>
              <p class="gate-tag" id="gate-tag">Proposed action: follow-up call, Tamil</p>
            </div>
          </div>
        </div>
      </section>

      <section id="engines" class="ch engines" data-state="engines" data-tone="light" aria-labelledby="h-engines">
        <div class="wrap engines-grid">
          <div class="stage lanes" data-stage>
            <ul class="index">
              {engines.map((e, i) => (
                <li style={`--i:${i}`}>
                  <button class="row" data-engine={e.id} data-n={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls="engine-preview">
                    <span class="row-name">{e.name}</span>{i === 0 && <small>Start here</small>}
                  </button>
                </li>
              ))}
            </ul>
          </div>
          <div class="engines-copy">
            <h2 id="h-engines" class="reveal">One core, six specialists</h2>
            <p class="fade">Start with collections and switch on the others without replacing your core systems. Availability of each engine for a deployment is confirmed during scoping.</p>
            <div class="preview" id="engine-preview" data-ui aria-live="polite">
              {engines.map((e, i) => (
                <div class="ep" data-for={e.id} hidden={i !== 0}>
                  <p class="card-title">{e.name} Intelligence</p>
                  <p class="ep-line">{e.line}</p>
                  <dl>
                    <div><dt>Reads</dt><dd>{e.inputs}</dd></div>
                    <div><dt>Does</dt><dd>{e.support}</dd></div>
                    <div><dt>Returns</dt><dd>{e.output}</dd></div>
                  </dl>
                </div>
              ))}
            </div>
          </div>
        </div>
        <p class="wrap products fade">Super Intelligence also coordinates the Voice India products already beside your agents: <a href="https://www.voiceindia.ai/augmented-ai">Augmented AI</a>, which puts account context and next-best-action guidance in front of an agent while the call is live, and <a href="https://www.voiceindia.ai/resonance">Resonance</a>, which checks every human and AI call for quality and configured compliance signals. Integration depends on the configured deployment and connectors; it is not automatic.</p>
        <svg class="crest" viewBox="0 0 1440 300" preserveAspectRatio="none" aria-hidden="true"><path d="M0 150C300 90 560 60 820 130S1240 230 1440 150V300H0Z" /></svg>
      </section>

      <section id="security" class="ch trust" data-state="trust" data-tone="dark" aria-labelledby="h-trust">
        <div class="wrap trust-grid">
          <div class="trust-copy">
            <h2 id="h-trust" class="reveal">It runs where your data already lives</h2>
            <p class="fade">On premise, in a private cloud or hybrid. Data flows in, is understood, and stops at your boundary. Each workflow reads only the fields it is permitted to use, and personal data never goes to a model or provider your policy forbids.</p>
            <table class="deploy" data-ui>
              <caption>Three ways to deploy</caption>
              <thead><tr><th scope="col">Model</th><th scope="col">Where Super Intelligence runs</th><th scope="col">Where your data goes</th></tr></thead>
              <tbody>
                <tr tabindex="0" data-row="0"><th scope="row">On premise</th><td>Your own data centre</td><td>Nowhere. It never leaves.</td></tr>
                <tr tabindex="0" data-row="1"><th scope="row">Private cloud</th><td>Your approved private infrastructure</td><td>Only inside that boundary</td></tr>
                <tr tabindex="0" data-row="2"><th scope="row">Hybrid</th><td>Split across both</td><td>Through one defined, approved flow</td></tr>
              </tbody>
            </table>
            <p class="fade small-dk">Residency, network egress, retention, external model use and audit requirements are agreed during solution design. On premise and private cloud are not assumed to be identical.</p>
          </div>
          <div class="stage walls-stage" data-stage aria-hidden="true"><span style="top:var(--y0,25%)">On premise</span><span style="top:var(--y1,50%)">Private cloud</span><span style="top:var(--y2,75%)">Hybrid</span><span class="edge">Your boundary</span></div>
        </div>
        <div class="wrap rules">
          <h3 class="rules-head fade">Written for the rules you answer to</h3>
          {rules.map((r) => (
            <div class="rule fade">
              <b>{r.by}</b>
              <p>{r.rule}</p>
              <p class="rule-how">{r.how}</p>
            </div>
          ))}
          <p class="rules-note fade">Designed to support these requirements. Your compliance team confirms the controls during solution design.</p>
        </div>
        <svg class="crest crest-light" viewBox="0 0 1440 300" preserveAspectRatio="none" aria-hidden="true"><path d="M0 190C360 250 700 140 1000 170S1320 230 1440 190V300H0Z" /></svg>
      </section>

      <section id="connect" class="ch connect" data-tone="light" aria-labelledby="h-connect" data-phase="read">
        <div class="wrap connect-head">
          <h2 id="h-connect" class="reveal">Read first. Act only where approved.</h2>
          <p class="fade">Super Intelligence starts with read access to the systems you already trust. It expands into approved actions only after data, security and operational validation.</p>
          <div class="phase" role="group" aria-label="Pilot phase">
            <button type="button" data-phase="read" aria-pressed="true">Phase one: read</button>
            <button type="button" data-phase="act" aria-pressed="false">Phase two: approved actions</button>
          </div>
        </div>
        <div class="wrap hub">
          <p class="hub-mini" aria-hidden="true"><i></i>Super Intelligence</p>
          <ul class="ports ports-l">
            {connectors.slice(0, 3).map((c) => <li data-acts={c.acts ? 'yes' : 'no'}><b>{c.name}</b><span>{c.reads}</span><em>{c.acts ? `Acts: ${c.acts.charAt(0).toLowerCase() + c.acts.slice(1)}` : 'Stays read-only'}</em></li>)}
          </ul>
          <svg class="hub-svg" viewBox="0 0 600 600" aria-hidden="true">
            <g class="wires"></g>
            <circle class="core" cx="300" cy="300" r="74" />
            <text x="300" y="292" text-anchor="middle" class="core-t">Super</text>
            <text x="300" y="318" text-anchor="middle" class="core-t">Intelligence</text>
          </svg>
          <ul class="ports ports-r">
            {connectors.slice(3).map((c) => <li data-acts={c.acts ? 'yes' : 'no'}><b>{c.name}</b><span>{c.reads}</span><em>{c.acts ? `Acts: ${c.acts.charAt(0).toLowerCase() + c.acts.slice(1)}` : 'Stays read-only'}</em></li>)}
          </ul>
        </div>
        <p class="wrap connect-note fade">Each connector is validated against your environment before use. No vendor is listed as supported until it has been checked.</p>
      </section>

      <section id="outcomes" class="ch outcomes" data-tone="dark" aria-labelledby="h-outcomes">
        <div class="wrap outcomes-grid">
          <div class="outcomes-head">
            <h2 id="h-outcomes" class="reveal">Judged by what changes</h2>
            <p class="fade">A pilot measures six things, against a baseline you agree before it starts. Actual impact depends on your portfolio, data quality, workflow design, policy and that baseline.</p>
          </div>
          <ol class="measures">
            {outcomes.map((o, i) => (
              <li data-i={i} data-active={i === 0 ? 'true' : 'false'}>
                <h3>{o.name}</h3>
                <div class="m-body">
                  <ul>{o.counts.map((c) => <li>{c}</li>)}</ul>
                  <p>{o.her}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section id="pilot" class="ch cta" data-state="cta" data-tone="light" aria-labelledby="h-cta">
        <div class="wrap cta-grid">
          <div class="cta-copy">
            <h2 id="h-cta" class="reveal">Prove it on one workflow first</h2>
            <p class="fade">Pick one collection segment or queue. Agree the baseline, the data it may use and who approves what. Run a controlled pilot, review the results, then decide what to scale.</p>
            <ol class="pilot fade">
              <li><b>Define</b> the use case, the baseline and what success means</li>
              <li><b>Connect</b> data access, permissions and integration scope</li>
              <li><b>Validate</b> recommendations, exceptions, security and outcomes</li>
              <li><b>Scale</b> only after operational and governance sign-off</li>
            </ol>
          </div>
          <form class="form" id="demo" data-ui action={`mailto:${mail}`} method="get" novalidate>
            <p class="card-title">Request a Collections SI demonstration</p>
            <div class="f2">
              <label>Name<input name="name" autocomplete="name" required /></label>
              <label>Work email<input name="email" type="email" autocomplete="email" required /></label>
            </div>
            <div class="f2">
              <label>Organisation<input name="org" autocomplete="organization" required /></label>
              <label>Role<input name="role" autocomplete="organization-title" /></label>
            </div>
            <div class="f2">
              <label>Use case
                <select name="usecase"><option>Collections</option><option>Customer service</option><option>Portfolio intelligence</option><option>Risk and compliance</option><option>Other</option></select>
              </label>
              <label>Deployment
                <select name="deploy"><option>Not sure yet</option><option>On premise</option><option>Private cloud</option><option>Hybrid</option></select>
              </label>
            </div>
            <label>What would you like to prove?<textarea name="brief" rows="3"></textarea></label>
            <div class="form-row">
              <button class="btn" type="submit">Prepare the request</button>
              <a class="link" href={`https://mail.google.com/mail/?view=cm&to=${mail}`} target="_blank" rel="noopener">Write in Gmail instead</a>
            </div>
            <p class="form-note" id="form-note">Opens a written email to {mail}. Please leave out confidential customer information.</p>
          </form>
        </div>
        <div class="stage foundation" data-stage aria-hidden="true"></div>
        <svg class="crest" viewBox="0 0 1440 300" preserveAspectRatio="none" aria-hidden="true"><path d="M0 170C320 120 600 70 900 120S1280 210 1440 160V300H0Z" /></svg>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap closing">
        <p class="closing-line fade">Account 1048 got one call, in Tamil, after payday. Which account is next?</p>
        <a class="btn fade" href="#pilot">Book a demonstration</a>
        <p class="closing-words fade">Intelligent. Compliant. Sovereign. Scalable.</p>
      </div>
      <div class="stage mark-stage" data-stage aria-hidden="true"></div>
      <div class="wrap foot-grid">
        <p class="foot-name"><b>Voice India Super Intelligence</b><br />AI-powered conversations. Stronger outcomes.</p>
        <ul>
          <li><a href="#account">Account 1048</a></li>
          <li><a href="#gate">The gate</a></li>
          <li><a href="#engines">Engines</a></li>
          <li><a href="#security">Security</a></li>
          <li><a href="#pilot">Pilot</a></li>
        </ul>
        <ul>
          <li><a href="https://www.voiceindia.ai/augmented-ai">Augmented AI</a></li>
          <li><a href="https://www.voiceindia.ai/resonance">Resonance</a></li>
          <li><a href="https://www.voiceindia.ai/">Voice India AI</a></li>
        </ul>
        <p class="contact"><a href={`mailto:${mail}`}>{mail}</a><br />Tell us what you would like to build.<br /><button class="copy" type="button" data-copy={mail}>Copy the address</button></p>
        <p class="legal">© 2026 Voice India. Account 1048 is a simulated case; no real customer data is shown.</p>
      </div>
    </footer>

    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
