---
import { Image } from 'astro:assets';
import { existsSync } from 'node:fs';
import logoLight from '../assets/voiceindia-logo-on-light.png';
import logoDark from '../assets/voiceindia-logo-on-dark.png';
import '../styles/global.css';
import { LANGS } from '../scripts/langs.js';

const site = 'https://voiceindia.si/';
const title = 'Voice India Super Intelligence for Banking and NBFCs';
const description =
  'Connect customer, loan and conversation context to governed decisions and permitted action. Voice India Super Intelligence for banking and NBFC collections.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${site}#org`, name: 'Voice India', url: 'https://www.voiceindia.ai/', logo: `${site}favicon.png`, email: 'tabassum.farheen@voiceindia.ai' },
    { '@type': 'WebSite', '@id': `${site}#site`, url: site, name: 'Voice India Super Intelligence', inLanguage: 'en-IN', publisher: { '@id': `${site}#org` } },
    {
      '@type': 'SoftwareApplication', name: 'Voice India Super Intelligence', applicationCategory: 'BusinessApplication',
      operatingSystem: 'On premise, private cloud or hybrid deployment', description, url: site, publisher: { '@id': `${site}#org` },
      audience: { '@type': 'BusinessAudience', name: 'Banks and NBFCs' },
      featureList: ['Collections Intelligence', 'Customer Intelligence', 'Conversation Intelligence', 'Portfolio Intelligence', 'Risk and Compliance Intelligence', 'Operations Intelligence'],
    },
  ],
};

// Her language: the hero's panel sets it, and every `{lang}` in the copy below follows (main.js). Hindi until then.
const her = LANGS[0];
const T = (text: string) => text.replaceAll('{lang}', `<span data-lang-name>${her.name}</span>`);

// The five places her story sits, and what each one knows about her. Each keeps one piece of her broken line
// (`piece`, as cut in wave.js: 4 is the word for salary, 0 to 3 the rest of the line from left to right).
// On a wide screen the pieces hang apart in the stage (x, y: the piece's centre, percent of the stage),
// each label on its outer side. The word for salary lands on the system that knows when it comes.
const sources = [
  { name: 'Customer record', fact: 'Mobile verified, KYC complete', piece: 1, x: 48.4, y: 24, side: 'above' },
  { name: 'Loan system', fact: '₹48,500, 23 days overdue', piece: 0, x: 33.5, y: 44, side: 'left' },
  { name: 'Call recordings', fact: '4 calls, 3 answered', piece: 2, x: 65, y: 40, side: 'right' },
  { name: 'Transactions', fact: 'Salary credited on the 7th, instalment due on the 1st', piece: 4, x: 34, y: 70, side: 'below' },
  { name: 'Policy PDF', fact: 'Calls 8 am to 7 pm, {lang} script approved', piece: 3, x: 63, y: 70, side: 'below' },
];
// the side labels share the stage's edge with the page margin, so they are narrower
const labelSide: Record<string, string> = {
  above: 'lg:bottom-full lg:left-0 lg:mb-3 lg:w-[14rem]',
  below: 'lg:top-full lg:left-0 lg:mt-3 lg:w-[14rem]',
  left: 'lg:top-1/2 lg:right-full lg:mr-5 lg:w-[11rem] lg:-translate-y-1/2 lg:text-right',
  right: 'lg:top-1/2 lg:left-full lg:ml-5 lg:w-[9.5rem] lg:-translate-y-1/2',
};

// Sample: her calls since the due date. Each caller saw one system; nobody carried what she said to the next.
const calls = [
  ['Day 3', 'No answer'],
  ['Day 9', 'Asked to be called in {lang}'],
  ['Day 15', '“I will pay, please give me time”', true],
  ['Day 21', '“After my salary comes”', true],
];

// The decision loop. The ring of particles holds still; the orange arc and the words move with scroll.
const loop = [
  ['Understand', 'Build a contextual view of the customer, the account, its history and the situation right now.', 'Her account, four calls and her language, read together for the first time.', '4 calls, 1\u00a0language'],
  ['Predict', 'Estimate likely outcomes, identify risks and surface the accounts that deserve attention first.', 'An account that answers calls but never promises is worth a different approach.', '3 explanations'],
  ['Decide', 'Recommend a next best action from evidence, institution policy and the options you have authorised.', 'One call, after her salary credit, inside permitted hours, in {lang}.', 'Call after salary'],
  ['Execute', 'Coordinate voice, messaging, human agents and enterprise workflows within assigned permissions.', 'The call is placed by the SI voice agent, with a person one click away.', 'Day\u00a08, 18:10'],
  ['Learn', 'Compare each recommendation with what actually happened, and improve through evaluated, governed updates.', 'Whether she paid is checked against the payment system, never assumed.', 'Payment checked'],
];

// Account 1048. `word` is what the particles spell beside the step.
const steps = [
  { word: '₹48,500', title: 'Why is this account stuck?', text: 'Four calls, no promise, 23 days past due. Super Intelligence reads the account, the calls and your policy together and proposes three explanations to test. The likeliest: her salary lands after the due date.' },
  { word: '{self}', title: 'Call after payday, in {lang}', text: 'One recommended action, backed by two facts on record: she asked for a call after payday, and she prefers {lang}. No score is invented to make it look certain.' },
  { word: 'APPROVE', title: 'Nothing reaches her without approval', text: 'The action is checked against contact hours, consent and authority, and higher-impact actions wait for an authorised person. Hold the button on the case to approve this one.' },
  { word: '{hello}', title: 'The call, in her language', text: 'The SI voice agent calls in {lang}, recognises her concern and records the follow-up she asks for. It makes no promise on her behalf.' },
  { word: 'CALLBACK', title: 'The outcome comes back', text: 'The disposition is logged, the payment is not assumed, and the result is compared with the recommendation. Strategy changes are approved before they reach production.' },
];

// The architecture, top to bottom. The packet falls through these.
const layers = [
  { name: 'Enterprise data and events', text: 'Core banking, LMS, CRM, payment status, telephony, conversations and approved knowledge sources.' },
  { name: 'Context and memory', text: 'Identity resolution where authorised, the account timeline, interaction memory, retrieval and a knowledge graph where implemented.' },
  { name: 'Intelligence', text: 'Rules and policies, predictive models, reasoning, next best action and specialist agents.' },
  { name: 'Orchestration and the policy gate', text: 'Every proposed action is checked against permissions and policy before it reaches a channel or system. High-impact actions and exceptions go to authorised staff. They never bypass the gate.' },
  { name: 'Channels and systems of action', text: 'Voice agents, messaging, human agents, collection workflows, CRM and LMS updates. Payment or system status is verified before an outcome is marked complete.' },
  { name: 'Governance and outcome monitoring', text: 'Access controls, PII controls, audit records, evaluation and monitoring. Each action leaves a copy of itself here.' },
];
const checks = ['Data boundaries', 'Policy-constrained action', 'Human review', 'Audit trail', 'Evaluation'];

const engines = [
  { id: 'collections', name: 'Collections', line: 'Ranks accounts, diagnoses failed attempts and recommends the next permitted recovery action.', inputs: 'Delinquency status, repayment history, contact attempts, previous commitments, approved recovery options.', support: 'Ranks accounts, proposes hypotheses for stalled recovery and compares permitted next actions.', output: 'A recommended next action with its evidence, for an agent or a workflow.' },
  { id: 'customer', name: 'Customer', line: 'One governed view of each customer, account history and interaction memory.', inputs: 'Permitted customer and account records, interaction history, consent and contact preferences.', support: 'Builds a single contextual view that downstream workflows read within their access rights.', output: 'A governed context summary for the workflow in question.' },
  { id: 'conversation', name: 'Conversation', line: 'Context that carries across voice and digital, and knows when a person should take over.', inputs: 'Transcripts and event streams from voice and digital channels, plus account context.', support: 'Identifies objections and intent, carries context between channels and flags when a person should take over.', output: 'Conversation summaries, captured follow-ups and handoff signals.' },
  { id: 'portfolio', name: 'Portfolio', line: 'Where recovery is slowing across buckets, products, channels and teams, and why.', inputs: 'Aggregated portfolio, bucket, product, channel and team data.', support: 'Compares segments and highlights where outcomes move away from the agreed baseline.', output: 'Manager views of patterns and candidate explanations.' },
  { id: 'risk', name: 'Risk and Compliance', line: 'Every workflow held to approved rules, with evidence kept and exceptions routed.', inputs: 'Approved rules and policies, workflow events, action and approval records.', support: 'Checks proposed actions against configured rules and marks exceptions.', output: 'Exception flags, retained evidence and review routing.' },
  { id: 'operations', name: 'Operations', line: 'Where work piles up, explained in plain language.', inputs: 'Queue, handling time, workflow and manual effort data.', support: 'Explains where work accumulates and proposes process changes for evaluation.', output: 'Plain-language explanations and recommended improvements.' },
];

// Real rules, phrased as what the product is built to respect. The institution's compliance team confirms the controls.
const rules = [
  { by: 'RBI', rule: 'Recovery calls only between 8 am and 7 pm, with no harassment, under a board-approved policy.', how: 'Contact windows and recovery options are policy. The gate blocks any action outside them.' },
  { by: 'TRAI', rule: 'Calls and messages follow consent and registered-sender rules under TCCCPR 2018.', how: 'Consent and contact preferences are read before any channel is used.' },
  { by: 'DPDPA', rule: 'The Digital Personal Data Protection Act, 2023: personal data used only for a stated, lawful purpose.', how: 'Each workflow reads only the fields its purpose permits, and every use is recorded.' },
];

// Connectors: start by reading, act only where an action is approved.
const connectors = [
  { name: 'Core banking and lending', reads: 'Her account and repayment schedule', acts: '' },
  { name: 'Loan management and collections', reads: '23 days past due, ₹48,500 outstanding', acts: 'Dispositions and scheduled next actions' },
  { name: 'CRM and case management', reads: 'Prefers {lang}, permitted contact hours', acts: 'Case notes and follow-ups' },
  { name: 'Telephony and communications', reads: 'Her four calls and what she said', acts: 'Approved calls and messages' },
  { name: 'Payments and reconciliation', reads: 'Checks for her salary-day payment', acts: '' },
  { name: 'Enterprise data and knowledge', reads: 'The recovery policy and approved scripts', acts: '' },
];

const outcomes = [
  { name: 'Recovery', counts: ['Collected amount', 'Recovery rate', 'Net recovery cost'], her: 'Did the ₹48,500 move, and what did it cost to move it?' },
  { name: 'Commitment', counts: ['Promise-to-pay rate', 'Kept promises', 'Broken promises'], her: 'One promise she keeps is worth more than three she breaks.' },
  { name: 'Contact', counts: ['Contact rate', 'Right-party contact', 'Attempts per resolution'], her: 'Four calls without a promise. The fifth should be the right one.' },
  { name: 'Experience', counts: ['Dispute resolution time', 'Complaint rate', 'Repeat contact'], her: 'She asked for one thing: a call after payday, in {lang}.' },
  { name: 'Operations', counts: ['Human handling time', 'Manual effort', 'Manager review time'], her: 'Agents spend their time on the moments that need a person.' },
  { name: 'Governance', counts: ['Policy exceptions', 'Action approval rate', 'Audit completeness'], her: 'Every action on her account can be traced and explained.' },
];

const mail = 'tabassum.farheen@voiceindia.ai';
// her recorded line; the Listen control appears only once the file is in public/audio
const hasVoice = existsSync('public/audio/her-line.mp3');

// Class strings used more than once. Tailwind reads them here like any other source.
const stage = 'pointer-events-none absolute inset-0 z-1';
const pin = 'sticky top-(--nav) z-3 h-[calc(100svh_-_var(--nav))] py-[clamp(20px,3.5vh,36px)] *:relative *:z-3 compact:pt-3.5 compact:pb-4 in-[.no-js]:relative in-[.no-js]:h-auto'; // the gate's pin differs and is written out in place
const crest = 'crest absolute inset-x-0 -bottom-px z-1 w-full';
const crestNavy = `${crest} h-[28svh] fill-navy max-sm:h-[14svh]`;
const crestLight = `${crest} crest-light h-[14svh] fill-white`;
const navLink = 'relative py-2 font-semibold text-on-navy no-underline transition-colors duration-200 hover:text-white after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:origin-left after:scale-x-0 after:rounded-full after:bg-orange after:transition-transform after:duration-300 after:ease-out hover:after:scale-x-100 group-data-[tone=light]/nav:text-slate group-data-[tone=light]/nav:hover:text-navy';
const footLink = 'text-white no-underline hover:underline';
const cardTitle = 'mb-1.5 text-body font-bold tracking-[-.01em] text-navy';
const arrow = 'arrow grid size-10 place-items-center rounded-[4px] bg-white text-navy transition-[scale,background-color] duration-150 ease-out active:scale-94 disabled:cursor-default disabled:opacity-35 enabled:hover:bg-ice motion-reduce:active:scale-100 [&_svg]:size-4 [&_svg]:fill-none [&_svg]:stroke-current [&_svg]:stroke-[1.8] [&_svg]:[stroke-linecap:round] [&_svg]:[stroke-linejoin:round]';
const ccBody = 'grid text-ink transition-[opacity,transform] duration-[360ms] ease-out group-data-[s=next]/li:hidden group-data-[s=done]/li:hidden group-data-[s=now]/li:animate-cc-in';
const ccNote = 'mt-1 text-[.875rem] text-slate';
const bubble = 'max-w-[88%] rounded-[10px] px-3 py-2 leading-[1.4] compact:px-2.5 compact:py-1.5 compact:text-[.875rem]';
const port = 'group/p relative grid content-center gap-[3px] text-small text-slate max-lg:pl-16 max-lg:text-left max-lg:before:absolute max-lg:before:top-2.5 max-lg:before:left-[41px] max-lg:before:h-px max-lg:before:w-[18px] max-lg:before:bg-blue/30 max-lg:before:content-[""] max-lg:after:absolute max-lg:after:top-[5px] max-lg:after:left-[31px] max-lg:after:size-3.5 max-lg:after:rounded-full max-lg:after:border-2 max-lg:after:border-blue max-lg:after:bg-white max-lg:after:content-[""] max-lg:in-data-[phase=act]:data-[acts=yes]:after:animate-outflow max-lg:in-data-[phase=act]:data-[acts=yes]:after:border-orange max-lg:in-data-[phase=act]:data-[acts=yes]:after:bg-orange motion-reduce:after:animate-none';
const portEm = 'translate-y-1 font-semibold text-[#94A3B8] not-italic opacity-0 transition-[opacity,translate] duration-300 ease-out in-data-[phase=act]:translate-y-0 in-data-[phase=act]:opacity-100 group-data-[acts=yes]/p:in-data-[phase=act]:text-rust';
const navItems = [['#account', 'Her account'], ['#gate', 'The gate'], ['#engines', 'Engines'], ['#security', 'Security'], ['#pilot', 'Pilot']];
const stats = [['Outstanding', '₹48,500'], ['Days past due', '23'], ['Language', '{lang}'], ['Contacts', '4', true], ['Promise to pay', 'None', true], ['Last outcome', 'Call after salary', true]];
---
<!doctype html>
<html lang="en-IN" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#071B49" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Understand every customer in context. Predict the next best action. Coordinate AI and human teams, with institutional control." />
    <meta property="og:image" content={`${site}og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Voice India Super Intelligence: the intelligence layer for banks and NBFCs." />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content="Customer context, governed decisions and permitted action for banking and NBFC collections." />
    <meta name="twitter:image" content={`${site}og.png`} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/jakarta.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.replace('no-js','js')</script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="absolute -top-15 left-3 z-30 bg-navy px-3.5 py-2.5 text-white focus:top-3" href="#main">Skip to content</a>
    <canvas id="field" class="pointer-events-none fixed inset-0 z-2 block h-lvh w-screen in-[.no-js]:hidden" aria-hidden="true"></canvas>

    <!-- The bar takes the ground beneath it: navy over the hero, frosted white over the pale chapters (main.js sets data-tone). -->
    <header class="group/nav sticky top-0 z-20 h-(--nav) bg-navy transition-[background-color,box-shadow] duration-300 ease-out data-[tone=light]:bg-white/85 data-[tone=light]:shadow-[0_1px_0_var(--color-line)] data-[tone=light]:backdrop-blur-md" id="nav" data-tone="dark">
      <div class="wrap flex h-full items-center justify-between gap-6">
        <a href="#top" class="relative block h-[38px] w-[152px]" aria-label="Voice India Super Intelligence, back to top">
          <Image src={logoDark} alt="Voice India" width={168} height={42} loading="eager" fetchpriority="high" class="absolute inset-0 size-full object-contain transition-opacity duration-300 group-data-[tone=light]/nav:opacity-0" />
          <Image src={logoLight} alt="" width={168} height={42} loading="eager" class="absolute inset-0 size-full object-contain opacity-0 transition-opacity duration-300 group-data-[tone=light]/nav:opacity-100" />
        </a>
        <nav aria-label="Sections" class="max-md:hidden">
          <ul class="flex gap-[clamp(20px,2.6vw,40px)] text-small font-semibold">
            {navItems.map(([href, label]) => <li><a class={navLink} href={href}>{label}</a></li>)}
          </ul>
        </nav>
        <a class="btn min-h-[42px] px-4.5 text-small" href="#pilot">Book a demo</a>
      </div>
    </header>

    <main id="main">
      <section id="top" class="ch relative overflow-clip bg-navy text-on-navy" data-state="hero" data-tone="dark" aria-labelledby="h-hero">
        <!-- Depth: the rosette engraved round the watermark of a banknote, in hairlines, far behind her line. It turns
             very slowly and drifts against the particles as the pointer moves (main.js draws it). -->
        <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true" data-depth>
          <div class="absolute inset-0" data-depth-in>
            <canvas class="absolute motion-safe:animate-[spin_480s_linear_infinite]" data-guilloche></canvas>
          </div>
        </div>
        <div class={stage} data-stage aria-hidden="true"></div>
        <!-- A poster: her line, in particles, is the picture and fills the screen; her voice runs edge to edge under it.
             The claim sits low, in a band of its own, so the first thing seen is what she said. -->
        <div class="wrap relative z-3 grid min-h-[max(640px,calc(100svh_-_var(--nav)))] grid-rows-[minmax(0,1fr)_auto] pt-[clamp(24px,4vh,48px)] pb-[clamp(56px,8vh,96px)] max-lg:min-h-0 max-lg:pt-8 max-lg:pb-16">
          <!-- Every line in an Indian script on this page is a draft, to be checked by a native speaker before launch. -->
          <figure class="grid content-center" id="voice" aria-label="What a simulated borrower said on her fourth call">
            <!-- The same words as type stand in where there are no particles. -->
            <div class="relative h-[clamp(220px,36svh,400px)] max-lg:h-[clamp(130px,32vw,260px)]" data-line>
              <p class="absolute inset-x-0 top-0 grid h-[80%] place-items-center text-[length:clamp(3rem,1rem_+_8vw,9.5rem)] leading-none font-semibold whitespace-nowrap text-white in-[.has-field]:opacity-0" lang={her.code} data-lang-line>{her.line}</p>
            </div>
            <!-- what she said, then the languages it can be said in: the panel of a banknote, set as one line -->
            <figcaption class="mt-[clamp(8px,1.6vh,20px)] grid justify-items-center gap-2 text-center text-small text-dim" data-voice-text data-picker>
              <p class="hero-in text-on-navy" data-hero-in="3">“After my salary comes,” said by a simulated borrower.</p>
              <div class="hero-in flex max-w-[64rem] flex-wrap justify-center gap-x-1 gap-y-1" data-hero-in="3" role="group" aria-label="Choose the language she speaks" data-panel>
                {LANGS.map((L, i) => (
                  <button type="button" class="rounded-[3px] px-2 py-1 leading-[1.3] transition-[color,box-shadow] duration-200 ease-out hover:text-white aria-pressed:text-white aria-pressed:shadow-[inset_0_-2px_var(--color-orange)]" data-lang={L.code} aria-pressed={i === 0 ? 'true' : 'false'}><span lang={L.code}>{L.self}</span>{L.code !== 'en' && <span class="sr-only">, {L.name}</span>}</button>
                ))}
              </div>
            </figcaption>
          </figure>
          <!-- the claim: the headline on the left, the sentence and the actions on the right, on one baseline band -->
          <div class="mt-[clamp(28px,5vh,64px)] grid grid-cols-[minmax(0,7fr)_minmax(0,5fr)] items-end gap-x-[clamp(32px,5vw,96px)] gap-y-6 max-lg:grid-cols-1" data-voice-text>
            <h1 id="h-hero" class="hero-in min-w-0 text-[length:clamp(2.5rem,.6rem_+_4vw,5rem)] leading-[1.02] font-semibold tracking-[-.04em] [overflow-wrap:break-word] text-white max-sm:text-[length:10vw]">Every late payment has a reason</h1>
            <div>
              <p class="hero-in max-w-[40ch] text-lead leading-[1.4] text-on-navy max-sm:text-body" data-hero-in="1">Super Intelligence helps banks and NBFCs hear each overdue borrower, then proposes the next call your team&nbsp;approves.</p>
              <div class="hero-in mt-[clamp(20px,3vh,32px)] flex flex-wrap items-center gap-x-8 gap-y-4" data-hero-in="2">
                <a class="btn" href="#pilot">Book a demo</a>
                <a class="link text-white decoration-white/35 hover:decoration-white" href="#account">Follow one case</a>
                {hasVoice && <button type="button" class="font-semibold text-white underline decoration-white/35 underline-offset-3 aria-pressed:decoration-orange" id="listen" aria-pressed="false">Hear her</button>}
              </div>
            </div>
          </div>
        </div>
        <!-- The pale chapter rises in a low wave as her line breaks into its five records. -->
        <svg class="pointer-events-none absolute inset-x-0 -bottom-px z-1 h-[clamp(32px,4.5svh,48px)] w-full fill-mist" viewBox="0 0 1440 140" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 64C170 42 330 22 500 42S790 105 980 82 1270 32 1440 48V140H0Z" />
        </svg>
      </section>

      <section id="problem" class="ch relative bg-mist pt-[clamp(72px,10vh,128px)] pb-[clamp(96px,14vh,170px)] text-ink max-lg:pt-10" data-state="scatter" data-tone="light" aria-labelledby="h-scatter">
        <!-- Her line breaks here. Each piece drifts down to the system that keeps it, its label beneath it. -->
        <div class="wrap relative z-3 grid grid-cols-[minmax(0,5fr)_minmax(0,7fr)] items-center gap-[clamp(32px,5vw,96px)] max-lg:grid-cols-1 max-lg:gap-12">
          <!-- top: the claim; middle: her four calls, each started from one piece; base: the line they lead to -->
          <!-- on stacked layouts the column dissolves into the section's grid, so the hold can follow the pieces -->
          <div class="flex flex-col gap-10 self-center max-lg:contents">
            <div>
              <h2 id="h-scatter" class="reveal text-navy">Her account sits in five systems</h2>
              <p class="fade mt-6 max-w-[38ch] text-lead leading-[1.45] text-slate">Each collector opened one of them, so nobody knew what she had already&nbsp;said.</p>
            </div>
            <ol class="fade grid max-w-[30rem] gap-3.5 text-body" aria-label="Her four calls since the due date" style="--d:180ms">
              {calls.map(([day, said, quote]) => (
                <li class="grid grid-cols-[5rem_minmax(0,1fr)] items-baseline gap-4 max-sm:grid-cols-[4rem_minmax(0,1fr)]">
                  <span class="text-small font-medium text-slate tabular-nums">{day}</span>
                  <span class={quote ? 'font-medium text-navy' : 'text-slate'} set:html={T(said)} />
                </li>
              ))}
            </ol>
            <!-- the line the four calls lead to. Once the visitor has held the pieces together it becomes what they found,
                 and stays. On stacked layouts it follows the pieces, so the conclusion comes after the evidence. -->
            <p class="fade max-w-[24ch] text-[length:clamp(1.5rem,1.1rem_+_.9vw,2rem)] leading-[1.2] font-medium tracking-[-.02em] text-navy max-lg:order-last" style="--d:260ms" id="fifth-call" aria-live="polite"><span class="inline-block transition-[opacity,filter] duration-300 ease-out" data-payoff>So the fifth call sounds like the first&nbsp;four.</span></p>
            <!-- Click, tap, or keyboard: bring the five pieces together into her line again. -->
            <div class="fade -mt-2 max-lg:order-last max-lg:-mt-4" style="--d:340ms" data-join-wrap hidden>
              <button class="relative h-12 overflow-hidden rounded-[4px] bg-blue px-6 font-semibold text-white transition-[scale] duration-150 ease-out select-none active:scale-98 motion-reduce:active:scale-100" id="join" type="button" aria-pressed="false">
                <span class="hold-label flex h-full items-center">Bring her five records together</span>
